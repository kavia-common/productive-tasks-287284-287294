# PUBLIC_INTERFACE
# Environment variables for the Todo Frontend (React)
# Copy this file to .env and adjust values for your environment.

# Base URL for the backend API, e.g. http://localhost:3001 or https://api.example.com
REACT_APP_API_BASE=http://localhost:3001

# Optional: logging level for the API client (error|warn|info|debug)
REACT_APP_LOG_LEVEL=info

# Optional: feature flags - either JSON or comma-separated keys (e.g. "newHeader,foo")
# Example JSON: {"newHeader":true}
REACT_APP_FEATURE_FLAGS=
