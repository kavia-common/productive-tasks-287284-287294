# Frontend environment variables
# Copy this file to ".env" and adjust values as needed for local development.
# Create React App only exposes variables prefixed with REACT_APP_.

# Base URL for the backend API. In development, point to the backend dev server.
# For local dev with Spring Boot backend on port 3001:
REACT_APP_API_BASE=http://localhost:3001/api

# Optional logging level for the frontend API client: error | warn | info | debug
REACT_APP_LOG_LEVEL=info

# Optional feature flags:
# JSON form: {"newUI": true, "betaFeature": true}
# or comma-separated form: newUI,betaFeature
# REACT_APP_FEATURE_FLAGS=
